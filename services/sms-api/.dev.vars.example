# Local development variables for `wrangler dev`.
#
# Copy to `.dev.vars` (gitignored) — `wrangler dev` reads that file, **not the shell
# environment**, so `LOCAL_EMAIL_LOG=true pnpm dev` has no effect and the magic-link
# adapter still throws "Email binding is not configured". That cost a debugging round.
#
#   cp .dev.vars.example .dev.vars
#
# Keep this file to vars that are **not** already in `wrangler.jsonc`. `.dev.vars`
# overrides the wrangler vars wholesale, and the vitest plugin loads it too — putting
# CORS_ORIGINS here silently broke the CORS suite, which expects the production origin.
#
# None of these are secrets. Anything secret belongs in `wrangler secret put` for a
# deployed Worker, never here.

# Writes email to the console instead of sending it, and prints the magic-link URL so
# sign-in works locally. Without it there is no email binding and no way to sign in.
LOCAL_EMAIL_LOG=true
