{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edapex-model-router",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],

  // No `routes` and `workers_dev: false`: this Worker has no public hostname.
  // It is reachable only through a service binding from cowork-api, so the AI
  // Gateway credential and the logging policy cannot be bypassed by a browser.
  "workers_dev": false,

  "vars": {
    // The Cloudflare account that owns the AI Gateway.
    "CF_ACCOUNT_ID": "",
    // The AI Gateway name, used to build the provider-passthrough URL.
    "AI_GATEWAY_ID": "edapex"
  },

  // Set outside git:
  //   pnpm exec wrangler secret put CF_AIG_TOKEN
  //
  // `CF_AIG_TOKEN` authorises the request to AI Gateway. The provider key is NOT
  // held here: it is stored in AI Gateway via BYOK (Secrets Store) and selected
  // per tenant with the `cf-aig-byok-alias` header.

  "observability": {
    "enabled": true,
    // Never log request bodies. Prompts contain school records.
    "logs": {
      "invocation_logs": false
    }
  }
}
