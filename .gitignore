uiland_chatgpt_web_images_figma

# Secrets never live in the repository, in either tree.
.env
.env.local
.env.production
.env.development

# Local scratch media. `boy_writing.mp4` (92 MB) was swept in by a `git add -A` and pushed,
# which is what triggered GitHub's large-file warning. Keep it on disk, out of history.
boy_writing.mp4
*.mp4

# Mobile frontend build output
/apps/desktop/mobile/dist/

# Tauri copies the frontend bundle and its config into the Android project on every build.
# Tracked Kotlin and resources are inputs; this directory is output.
/apps/desktop/src-tauri/gen/android/app/src/main/assets/
