# Built browser agent runtime: generated by `pnpm --dir apps/web run build:agent-runtime`.
# CI rebuilds it in the `wasm` job before the browser suite runs.
/apps/web/public/agent-runtime/

# vinext dev-server scratch
/apps/web/.vinext/

# Vendored SQLite WASM engine: generated by `pnpm --dir apps/web run build:sqlite-runtime`.
/apps/web/public/sqlite/

