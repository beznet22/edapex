# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

# Security: Default to false for anonymous chats
PUBLIC_ALLOW_ANONYMOUS_CHATS=false

# ─────────────────────────────
# 🔐 API Keys
# ─────────────────────────────

GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL="mistral-ocr-latest"

NVIDIA_NIM_API_KEY=your-nvidia-api-key
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL=

OPENCODE_API_KEY=your-deepseek-api-key
OPENCODE_BASE_URL="https://opencode.ai/zen/v1/models"
OPENCODE_MODEL=

# Kimchi — Cast AI proxy. The API key is hardcoded in the kimchi CLI's
# public source, so it functions as a free-tier default. Users can override
# via the Settings UI. `KIMCHI_VERSION` (optional) pins the dynamic User-Agent
# version; leave blank to auto-resolve from GitHub (24h in-memory cache).
KIMCHI_API_KEY=your-kimchi-api-key
# KIMCHI_VERSION=


# ─────────────────────────────
# 🔐 JWT + Encryption Keys
# ─────────────────────────────
JWT_SIGN_SECRET="your-jwt-signing-secret"
JWE_ENC_SECRET="your-jwe-encryption-secret"
FILE_SHARE_SECRET="your-file-share-signing-secret"

# ─────────────────────────────
# 🌐 SMTP
# ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-app-password"
SMTP_FROM=noreply@yourdomain.com
SMTP_TO="admin@yourdomain.com"
SMTP_FROM_NAME="Your School Name"

# ─────────────────────────────
# 📁 File Storage
# ─────────────────────────────
STORAGE_DIR=/path/to/storage

# ─────────────────────────────
# 🤖 AI Providers
# ─────────────────────────────
# AES-256 encryption key for API key storage (32+ chars recommended)
# Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="your-encryption-key-here"

# Global fallback keys (server-side only, not per-user)
NVIDIA_API_KEY=""
MISTRAL_API_KEY=""

# ─────────────────────────────
# 📲 Telegram Bot
# ─────────────────────────────
# Bot token from @BotFather (https://t.me/BotFather). The Chat SDK Telegram
# adapter auto-reads these env vars when createTelegramAdapter() is called
# with no arguments.
TELEGRAM_BOT_TOKEN=""
# Public @username of the bot (without the leading @). Used to build the
# t.me/<username>?start=<token> deep link parents click to open Telegram.
TELEGRAM_BOT_USERNAME=""
# ──────────────────────────────────────────────────────────────────────
# 🛎️  Telegram admin log forwarding (optional)
# ──────────────────────────────────────────────────────────────────────
# Telegram chat_id (numeric, as a string) of the admin/operator who should
# receive bot error logs. The admin MUST /start the bot first so Telegram
# accepts the message. Leave empty to disable admin log forwarding — the
# bot will then only write to the server log.
TELEGRAM_ADMIN_CHAT_ID=""
# Token-bucket burst capacity: maximum number of error log messages sent
# in a single window. Excess is dropped silently.
TELEGRAM_LOG_BURST="20"
# Refill rate: how long (in milliseconds) it takes to fully refill the
# token bucket. Default 60000 = 1 minute.
TELEGRAM_LOG_RATE="60000"
# Dedup window: messages with the same source + normalized message within
# this many ms collapse to a single Telegram message + a summary at
# window expiry. Default 300000 = 5 minutes.
TELEGRAM_LOG_DEDUP_MS="300000"
