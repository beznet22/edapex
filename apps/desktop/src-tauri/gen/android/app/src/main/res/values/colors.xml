<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The splash background is `--background` from the token sheet, in sRGB. It has to be a
      literal: Android resolves this before any CSS exists. The dark pair lives in
      values-night/colors.xml. A change here without the token changing would show as a
      flash at the handoff, which is the one thing the splash exists to prevent.
    -->
    <color name="splash_background">#FBFBFD</color>
    <color name="icon_background">#FBFBFD</color>
</resources>
