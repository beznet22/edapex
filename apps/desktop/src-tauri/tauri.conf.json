{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdApex Work",
  "version": "0.1.0",
  "identifier": "ng.llacademy.edapex",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5181/workspace",
    "beforeBuildCommand": "pnpm --dir ../web build:mobile",
    "frontendDist": "../../web/.cloudflare/output/v0/workers/default/assets"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["edapex"]
      },
      "mobile": [
        {
          "scheme": ["edapex"]
        }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "EdApex Work",
        "url": "/workspace/",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' https://api.llacademy.ng",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "EdApex school operations and cowork workspace",
    "longDescription": "EdApex Work runs the school workspace and the local agent runtime on desktop and mobile.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ocr/manifest.json",
      "resources/ocr/det.onnx",
      "resources/ocr/rec.onnx",
      "resources/ocr/dict.txt"
    ]
  }
}
