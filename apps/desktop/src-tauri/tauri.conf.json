{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdApex Work",
  "version": "0.1.0",
  "identifier": "ng.llacademy.edapex",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --port 5180",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EdApex Work",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
