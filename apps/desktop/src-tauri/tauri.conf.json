{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdApex Work",
  "version": "0.1.0",
  "identifier": "ng.llacademy.edapex",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5181/workspace",
    "beforeBuildCommand": "pnpm --dir ../web build:mobile",
    "frontendDist": "../../web/.cloudflare/output/v0/workers/default/assets"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["edapex"]
      },
      "mobile": [
        {
          "scheme": ["edapex"]
        }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "EdApex Work",
        "url": "/workspace/",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "resources/ocr/manifest.json",
      "resources/ocr/det.onnx",
      "resources/ocr/rec.onnx",
      "resources/ocr/dict.txt"
    ]
  }
}
