{
  "name": "edapex-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:expectations": "node scripts/gen-schema-expectations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:schema-drift": "drizzle-kit generate && git diff --exit-code -- src/lib/server/db/migrations",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:boundaries:self": "node scripts/check-import-boundaries.mjs --self-test",
    "check:repository": "node scripts/check-repository-rules.mjs",
    "check:repository:self": "node scripts/check-repository-rules.mjs --self-test",
    "check:repository-map": "node scripts/check-repository-map.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.10",
    "wrangler": "^4.158.0"
  }
}
