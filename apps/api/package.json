{
  "name": "edapex-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:expectations": "node scripts/gen-schema-expectations.mjs",
    "db:import-report-settings": "node scripts/import-report-settings.mjs",
    "auth:claim-reset-sql": "node scripts/gen-claim-reset-sql.mjs",
    "bench:claim": "node scripts/bench-claim.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:schema-drift": "drizzle-kit generate && git diff --exit-code -- src/lib/server/db/migrations",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:boundaries:self": "node scripts/check-import-boundaries.mjs --self-test",
    "check:repository": "node scripts/check-repository-rules.mjs",
    "check:repository:self": "node scripts/check-repository-rules.mjs --self-test",
    "check:repository-map": "node scripts/check-repository-map.mjs",
    "check:services": "node scripts/check-service-rules.mjs",
    "check:services:self": "node scripts/check-service-rules.mjs --self-test",
    "check:service-map": "node scripts/check-service-map.mjs",
    "check:http": "node scripts/check-http-rules.mjs",
    "check:http:self": "node scripts/check-http-rules.mjs --self-test",
    "check:migration": "node scripts/check-migration-rules.mjs",
    "check:migration:self": "node scripts/check-migration-rules.mjs --self-test",
    "migration:transform": "node scripts/migration/transform-cli.mjs",
    "migration:load": "node scripts/migration/load-cli.mjs",
    "migration:rehearse": "node scripts/migration/rehearse.mjs",
    "migration:verify": "node scripts/migration/verify.mjs",
    "migration:report": "node scripts/migration/report.mjs",
    "cutover:preflight": "node scripts/cutover/preflight.mjs",
    "cutover:drill": "node scripts/cutover/drill.mjs",
    "cutover:archive-export": "node scripts/cutover/archive-export.mjs",
    "cutover:live-plan": "node scripts/cutover/live-plan.mjs",
    "cutover:load-window": "node scripts/cutover/load-window.mjs",
    "cutover:live-verify": "node scripts/cutover/live-verify.mjs",
    "cutover:photo-inventory": "node scripts/cutover/photo-inventory.mjs",
    "cutover:missing-photo-students": "node scripts/cutover/missing-photo-students.mjs",
    "cutover:photo-audit": "node scripts/cutover/photo-audit.mjs",
    "phase9:retention-dry-run": "node scripts/phase9/retention-dry-run.mjs",
    "phase9:archive-manifests": "node scripts/phase9/archive-manifests.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.16",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.10",
    "wrangler": "^4.158.0"
  }
}
