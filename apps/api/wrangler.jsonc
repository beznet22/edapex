{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edapex-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edapex",
      // Placeholder until the production D1 database exists (Phase 7/8).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/lib/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: pnpm exec wrangler r2 bucket create edapex-media
      "bucket_name": "edapex-media"
    }
  ]
}
