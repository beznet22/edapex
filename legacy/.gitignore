# Paths generated by the legacy app.
#
# A leading `/` anchors a rule to *this* directory, which is what we want: without
# it, `build` would ignore `src/lib/server/build` anywhere in the tree.
#
# Trailing slashes are deliberately absent. `/coverage/` only matches a directory,
# so the rule silently stops working if the path is ever a file or symlink — which
# reads as "the ignore file is not working" rather than as a malformed rule.

/.svelte-kit
/.workspace
/build
/bin/lib
/coverage
/node_modules

# Runtime scratch
/tests/.tmp
/static/uploads/logos

# Local database files, including SQLite's WAL sidecars. Omitting the -wal/-shm
# pair leaves committed database pages behind after a crash.
/storage/*.db
/storage/*.db-wal
/storage/*.db-shm
edapexdb.sql

# Secrets
.env
.env.local
.env.production
.env.development
