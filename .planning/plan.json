{
  "goal": "Build integration tests for services and repository methods called by workflows in EdApex Mastra migration. Target the live devdb via transactional rollback fixtures.",
  "version": "1.0.0",
  "created_at": "2026-06-17",
  "conventions": {
    "test_db_url_from_env": true,
    "type_safety": "strict, no any, no @ts-ignore",
    "rollback_strategy": "db.transaction with afterEach rollback",
    "id_sandbox_range": [9999000, 9999999]
  },
  "dispatch_groups": [
    {
      "id": "G1",
      "label": "Infrastructure",
      "parallel_safe": true,
      "depends_on": [],
      "microtasks": ["mt-001", "mt-002", "mt-003", "mt-004", "mt-005"]
    },
    {
      "id": "G2",
      "label": "Per-Repo Integration Tests",
      "parallel_safe": true,
      "depends_on": ["G1"],
      "microtasks": ["mt-006-base-repo", "mt-007-student-repo", "mt-008-result-repo", "mt-009-mention-resolver"]
    },
    {
      "id": "G3",
      "label": "Workflow Integration Tests",
      "parallel_safe": true,
      "depends_on": ["G2"],
      "microtasks": ["mt-010-chat-workflow", "mt-011-editor-command-workflow"]
    },
    {
      "id": "G4",
      "label": "Validation",
      "parallel_safe": false,
      "depends_on": ["G3"],
      "microtasks": ["mt-012-validation-and-report"]
    }
  ],
  "validation": {
    "post_each_group": [
      "ls .planning/claims/  # must be empty",
      "cat .planning/ledger.jsonl  # all group tasks completed",
      "mysql -h 127.0.0.1 -u devuser -p'paxxw0rd@2791' devdb -e \"SELECT COUNT(*) FROM sm_students WHERE id BETWEEN 9999000 AND 9999999\"  # expect 0",
      "pnpm run check",
      "pnpm test  # existing mock tests still green"
    ]
  }
}