{
	"name": "edapex-db-foundation",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:backend": "wrangler dev src/server.ts",
		"build": "vite build",
		"preview": "vite preview",
		"start": "wrangler deploy",
		"clean": "rm -rf dist .wrangler .vinxi",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src --ext .ts,.tsx",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:local": "wrangler d1 migrations apply edapex_db --local",
		"db:migrate:prod": "wrangler d1 migrations apply edapex_db --remote",
		"db:studio": "drizzle-kit studio",
		"docker:build": "docker build -t edapex-v2 .",
		"docker:up": "docker-compose up -d --build",
		"docker:down": "docker-compose down"
	},
	"dependencies": {
		"@libsql/client": "^0.17.2",
		"@mastra/core": "^1.17.0",
		"@mastra/openai": "^1.0.1-alpha.50",
		"@paralleldrive/cuid2": "^3.3.0",
		"@tanstack/db": "^0.6.1",
		"@tanstack/intent": "^0.0.27",
		"@types/better-sqlite3": "^7.6.13",
		"@types/pg": "^8.20.0",
		"better-sqlite3": "^12.8.0",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.7",
		"mysql2": "^3.15.3",
		"pg": "^8.20.0",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@types/node": "^22",
		"drizzle-kit": "^0.31.7",
		"tsx": "^4.19.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.2",
		"wrangler": "^3.109.2"
	}
}
